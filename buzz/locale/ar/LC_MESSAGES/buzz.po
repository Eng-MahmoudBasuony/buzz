msgstr "{status} ({progress:.0%}) — المتبقي: {eta}"

msgid "{seconds}s"
msgstr "{seconds} ث"

msgid "{minutes}m {rest}"
msgstr "{minutes} د {rest}"

msgid "{hours}h {rest}"
msgstr "{hours} س {rest}"

msgid "{minutes}m {seconds}s"
msgstr "{minutes} د {seconds} ث"

msgid "Speed:"
msgstr "سرعة التشغيل:"

