{
  "manifest_version": 3,
  "name": "Buzz — YouTube to Text",
  "version": "1.0.0",
  "description": "ابدأ تفريغ فيديو يوتيوب في Buzz بضغطة واحدة.",
  "permissions": [
    "activeTab",
    "nativeMessaging"
  ],
  "action": {
    "default_title": "تفريغ الفيديو في Buzz",
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "key": "",
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
